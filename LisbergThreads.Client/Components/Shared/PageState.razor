<div class="page-state @(Compact ? "page-state-compact" : "")" role="@(IsError ? "alert" : "status")">
    @if (IsLoading)
    {
        <span class="spinner-border page-state-spinner" aria-hidden="true"></span>
    }
    <h2>@Title</h2>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p>@Message</p>
    }
    @if (ChildContent is not null)
    {
        <div class="page-state-actions">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsError { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
