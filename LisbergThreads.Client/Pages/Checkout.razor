@page "/checkout"

<PageTitle>Checkout</PageTitle>

<div class="overview-page checkout-page">
<header class="overview-header">
    <span class="overview-eyebrow">Lisberg Threads · Din bestilling</span>
    <h1>Checkout</h1>
    <p>Udfyld dine oplysninger, og kontrollér din ordre før bestilling.</p>
</header>

<FeedbackNotice Message="@ErrorMessage" IsError="true" />

@if (IsLoading)
{
    <PageState Title="Gør klar til checkout" Message="Et øjeblik, mens vi henter din kurv." IsLoading="true" />
}
else if (Cart is null)
{
    <PageState Title="Kurven kunne ikke hentes" Message="@LoadError" IsError="true">
        <button type="button" class="btn btn-outline-secondary" @onclick="LoadCartAsync">Prøv igen</button>
    </PageState>
}
else if (Cart.Items.Count == 0)
{
    <PageState Title="Din kurv er tom" Message="Tilføj varer, før du går til checkout.">
        <a class="btn btn-success" href="/products">Se produkter</a>
    </PageState>
}
else
{
    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <EditForm Model="Model" OnValidSubmit="CheckoutAsync" class="checkout-form">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <h2>Kontaktoplysninger</h2>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="checkout-first-name">Fornavn</label>
                        <InputText id="checkout-first-name" autocomplete="given-name" class="form-control"
                                   @bind-Value="Model.FirstName" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="checkout-last-name">Efternavn</label>
                        <InputText id="checkout-last-name" autocomplete="family-name" class="form-control"
                                   @bind-Value="Model.LastName" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="checkout-email">E-mail</label>
                    <InputText id="checkout-email" autocomplete="email" class="form-control"
                               type="email"
                               @bind-Value="Model.Email" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="checkout-phone">Telefon</label>
                    <InputText id="checkout-phone" autocomplete="tel" type="tel" class="form-control"
                                    inputmode="numeric"
                                    pattern="[0-9]*"
                                    @bind-Value="Model.Phone" />
                </div>

                <h2 class="checkout-section-heading">Levering</h2>

                <div class="mb-3">
                    <label class="form-label" for="checkout-address">Adresse</label>
                    <InputText id="checkout-address" autocomplete="street-address" class="form-control"
                               @bind-Value="Model.Address" @bind-Value:after="ResetServicePoints" disabled="@IsSaving" />
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label" for="checkout-postal-code">Postnummer</label>
                        <InputText id="checkout-postal-code" autocomplete="postal-code" class="form-control"
                                   @bind-Value="Model.PostalCode" @bind-Value:after="ResetServicePoints" disabled="@IsSaving" />
                    </div>

                    <div class="col-md-8 mb-3">
                        <label class="form-label" for="checkout-city">By</label>
                        <InputText id="checkout-city" autocomplete="address-level2" class="form-control"
                                   @bind-Value="Model.City" @bind-Value:after="ResetServicePoints" disabled="@IsSaving" />
                    </div>
                </div>

                <p class="form-text">Vi leverer i Danmark.</p>
                <fieldset class="shipping-methods" disabled="@IsSaving">
                    <legend>Vælg levering</legend>
                    <InputRadioGroup @bind-Value="SelectedMethodId" @bind-Value:after="ResetServicePoints">
                        @foreach (var method in ShippingMethods)
                        {
                            <label class="shipping-choice" for="shipping-@method.Id">
                                <InputRadio id="@($"shipping-{method.Id}")" Value="@method.Id" disabled="@(!method.IsAvailable)" />
                                <span>@method.Name</span>
                                <strong>@(method.IsAvailable ? method.Price!.Value.ToString("C") : "Ikke tilgængelig")</strong>
                            </label>
                        }
                    </InputRadioGroup>
                    @if (!ShippingMethods.Any(method => method.IsAvailable))
                    {
                        <p class="form-text">Levering er endnu ikke klar. Du kan bestille, når levering og betaling er åbnet.</p>
                    }
                    @if (SelectedMethod is { RequiresServicePoint: true, IsAvailable: true })
                    {
                        <button type="button" class="btn btn-outline-success my-2" @onclick="FindServicePointsAsync"
                                disabled="@IsLoadingServicePoints">@(IsLoadingServicePoints ? "Søger…" : "Find pakkeshops")</button>
                        <FeedbackNotice Message="@ShippingError" IsError="true" />
                        @if (ServicePoints.Count > 0)
                        {
                            <label class="form-label" for="checkout-service-point">Vælg pakkeshop</label>
                            <InputSelect id="checkout-service-point" class="form-select" @bind-Value="SelectedServicePointId">
                                <option value="">Vælg en pakkeshop</option>
                                @foreach (var point in ServicePoints)
                                {
                                    <option value="@point.Id">@point.Name · @point.Address @point.Address2, @point.PostalCode @point.City</option>
                                }
                            </InputSelect>
                        }
                    }
                </fieldset>

                <h2 class="checkout-section-heading">Betaling</h2>

                @if (PaymentOptions?.IsTestMode == true)
                {
                    <p><strong>Testordre – ingen betaling</strong></p>
                    <p class="form-text">Ordren gemmes, og varerne trækkes fra lageret. Der reserveres eller hæves ingen penge.</p>
                }
                else
                {
                    <div class="form-check mb-3">
                        <InputRadioGroup @bind-Value="Model.PaymentMethod">
                            <div class="form-check">
                                <InputRadio id="checkout-mobilepay" class="form-check-input" Value="@("MobilePay")" />
                                <label class="form-check-label" for="checkout-mobilepay">MobilePay</label>
                            </div>
                        </InputRadioGroup>
                    </div>
                    <p class="form-text">Beløbet reserveres ved godkendelse i MobilePay og hæves, når ordren afsendes. Varerne reserveres ikke, mens betalingen afventer godkendelse.</p>
                }
                @if (PaymentOptions is { IsAvailable: false })
                {
                    <FeedbackNotice Message="Checkout er ikke aktiveret. Kontakt Lisberg Threads, hvis du vil bestille." IsError="true" />
                }
                <div class="checkout-actions">
                    <button type="submit"
                            class="btn btn-success"
                            disabled="@(!CanCheckout)">
                        @(IsSaving ? "Behandler…" : PaymentOptions?.IsTestMode == true ? "Gennemfør testordre" : "Fortsæt til MobilePay")
                    </button>

                    <button type="button"
                            class="btn btn-outline-success"
                            @onclick="BackToCart"
                            disabled="@IsSaving">
                        Tilbage til kurv
                    </button>
                </div>
            </EditForm>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card overview-order-card">
                <div class="card-body">
                    <h2 class="card-title">Din ordre</h2>

                    @foreach (var item in Cart.Items)
                    {
                        <div class="checkout-line border-bottom py-2">
                            <div>
                                <strong>@item.Name</strong>
                                <div class="small text-muted">
                                    @item.Quantity × @item.UnitPrice.ToString("C")
                                </div>
                            </div>

                            <div>
                                @item.LineTotal.ToString("C")
                            </div>
                        </div>
                    }

                    <div class="checkout-line pt-3"><span>Varer</span><span>@Cart.Total.ToString("C")</span></div>
                    <div class="checkout-line pt-2"><span>Fragt</span><span>@(ShippingTotal?.ToString("C") ?? "Vælg levering")</span></div>
                    <div class="checkout-total">
                        <strong>Total</strong>
                        <strong>@(ShippingTotal.HasValue ? (Cart.Total + ShippingTotal.Value).ToString("C") : "Vælg levering")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
</div>
