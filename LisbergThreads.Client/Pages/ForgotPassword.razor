@page "/forgot-password"

<PageTitle>Glemt adgangskode</PageTitle>

<div class="auth-page">
    <h1 class="h3">Glemt adgangskode</h1>
    <p>Indtast din e-mailadresse for at bede om et link til at nulstille adgangskoden. Linket er gyldigt i én time.</p>
    @if (ErrorMessage is not null)
    {
        <FeedbackNotice Message="@ErrorMessage" IsError="true" />
    }
    @if (SuccessMessage is not null)
    {
        <FeedbackNotice Message="@SuccessMessage" />
    }
    <EditForm EditContext="FormContext" OnSubmit="SendAsync" novalidate>
        <DataAnnotationsValidator />
        <fieldset disabled="@IsSending">
            <div class="mb-3">
                <label class="form-label" for="forgot-email">E-mail</label>
                <InputText id="forgot-email" class="form-control" type="email" autocomplete="email" @bind-Value="Model.Email" />
                <ValidationMessage For="() => Model.Email" />
            </div>
            <button class="btn btn-primary" type="submit">@(IsSending ? "Sender..." : "Send nulstillingslink")</button>
        </fieldset>
    </EditForm>
    <p class="mt-3"><a href="/login">Tilbage til login</a></p>
</div>
