@page "/reset-password"

<PageTitle>Nulstil adgangskode</PageTitle>

<div class="auth-page">
    <h1 class="h3">Nulstil adgangskode</h1>
    @if (!HasValidLink)
    {
        <FeedbackNotice Message="Linket er ugyldigt eller mangler oplysninger. Bed om et nyt link." IsError="true" />
    }
    else
    {
        <p>Vælg en ny adgangskode til @Email.</p>
        @if (ErrorMessage is not null)
        {
            <FeedbackNotice Message="@ErrorMessage" IsError="true" />
        }
        <EditForm EditContext="FormContext" OnSubmit="ResetAsync" novalidate>
            <DataAnnotationsValidator />
            <fieldset disabled="@IsSaving">
                <div class="mb-3">
                    <label class="form-label">Ny adgangskode</label>
                    <PasswordInput Value="@Model.NewPassword" ValueChanged="OnPasswordChanged" Autocomplete="new-password" />
                    <div class="form-text">Mindst 6 tegn, et stort og et lille bogstav, et tal og et specialtegn.</div>
                    <ValidationMessage For="() => Model.NewPassword" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Bekræft ny adgangskode</label>
                    <PasswordInput Value="@Model.ConfirmPassword" ValueChanged="OnConfirmPasswordChanged" Autocomplete="new-password" />
                    <ValidationMessage For="() => Model.ConfirmPassword" />
                </div>
                <button class="btn btn-primary" type="submit">@(IsSaving ? "Gemmer..." : "Nulstil adgangskode")</button>
            </fieldset>
        </EditForm>
    }
    <p class="mt-3"><a href="/forgot-password">Bed om et nyt nulstillingslink</a></p>
    <p><a href="/login">Tilbage til login</a></p>
</div>
